# Ghostty Configuration
# https://ghostty.org/docs
# https://qiita.com/genimura/items/7fad3295c4de5538d6fe
# https://zenn.dev/mozumasu/scraps/192ee90fde246f

# ------------------------------------------------------------------------------
# キーバインド設定
# ------------------------------------------------------------------------------
# Cmd+C: マウス選択したテキストのコピー
keybind = super+c=copy_to_clipboard

# Cmd+V: クリップボードからペースト
keybind = super+v=paste_from_clipboard

# Cmd+X: 削除済み（未使用のため、F14がCmd+Zと競合していた）


# 選択したテキストを自動でクリップボードにコピー
copy-on-select = true

# 右クリックでペースト
# right-click-action = paste

# クリップボードの読み書きを許可
clipboard-read = allow
clipboard-write = allow

# タイピング中にマウスカーソルを隠す
mouse-hide-while-typing = true

# GhosttyがCmd+Sを奪わないようにする
keybind = super+s=unbind

# Neovim用カスタムキーバインド（F13-F15）
# Cmd+/ を F13 キーとして送信（コメントトグル）
keybind = super+/=text:\x1b[25~

# Cmd+Z を F14 キーとして送信（Undo）
keybind = super+z=text:\x1b[26~

# Cmd+Shift+Z を F15 キーとして送信（Redo）
keybind = super+shift+z=text:\x1b[28~

# Shift+Enter → Option+Enter として送信
# Claude Codeでの改行、Neovimでの空行追加に使用
keybind = shift+enter=text:\x1b\x0d

# ------------------------------------------------------------------------------
# tmux用カスタムキーバインド（F16-F23）
# ------------------------------------------------------------------------------
# 注意: Ghosttyは right_super をサポートしていません
# Right_Cmd+キーは、Karabinerで Left_Cmd+別のキー に変換してから受け取ります

# ウィンドウ管理
# F16: Left_Cmd+W → ウィンドウ/ペイン削除
keybind = super+w=text:\x1b[31~
# F17: Left_Cmd+T → 新しいウィンドウ作成
keybind = super+t=text:\x1b[29~

# ウィンドウ移動（Karabiner経由: Right_Cmd+I/O → Left_Cmd+,/.）
# F18: Cmd+, (実際はRight_Cmd+I) → 前のウィンドウ
keybind = super+comma=text:\x1b[32~
# F19: Cmd+. (実際はRight_Cmd+O) → 次のウィンドウ
keybind = super+period=text:\x1b[33~

# ------------------------------------------------------------------------------
# Quick Terminal用フォールバック（削除して元に戻せる）
# ------------------------------------------------------------------------------
# Quick TerminalではKarabinerのfrontmost_application_if条件がマッチしないため、
# 他のアプリ用のルールが適用される。これらのキーもtmux/Neovim用として処理する。
# ※ Ghosttyのデフォルト機能を上書きする
# 元に戻す場合: 以下の行を削除またはコメントアウト

# tmux用: Right_Cmd+I/O → Cmd+Shift+[/Cmd+[ (change order)
keybind = super+shift+bracket_left=text:\x1b[32~
keybind = super+bracket_left=text:\x1b[33~

# Neovim用: Right_Cmd+J/K/L/; → Ctrl+Shift+Tab/Ctrl+Tab/Cmd+]/Cmd+\
keybind = ctrl+shift+tab=text:\x1b[1;3P
keybind = ctrl+tab=text:\x1b[1;3Q
keybind = super+bracket_right=text:\x1b[1;3R
keybind = super+backslash=text:\x1b[1;3S

# ------------------------------------------------------------------------------
# Neovim用カスタムキーバインド（Karabiner経由でFunction Keyに変換）
# ------------------------------------------------------------------------------
# Ghosttyのデフォルトキーバインドを無効化して、Karabinerで変換されたキーを通過させる

# Karabinerで Right_Cmd+J → F24, Right_Cmd+; → F25 に変換される
# GhosttyはこれらのFunction Keyをそのまま通過させる（何もバインドしない）

# Karabinerで Right_Cmd → Left_Cmd に変換
# Ghosttyで Left_Cmd → Alt+Fキーのエスケープシーケンスに変換
# Alt+F1 (^[[1;3P): Neovim 前のバッファ
keybind = super+j=text:\x1b[1;3P
# Alt+F2 (^[[1;3Q): Neovim 次のバッファ
keybind = super+semicolon=text:\x1b[1;3Q
# Alt+F3 (^[[1;3R): Neovim カーソル位置を戻る (Ctrl+O)
keybind = super+k=text:\x1b[1;3R
# Alt+F4 (^[[1;3S): Neovim カーソル位置を進む (Ctrl+I)
keybind = super+l=text:\x1b[1;3S

# ペイン分割
# F22: Left_Cmd+D → 縦分割（左右）
keybind = super+d=text:\x1b[24~
# F23: Left_Cmd+Shift+D → 横分割（上下）
keybind = super+shift+d=text:\x1b[1;2P

# ------------------------------------------------------------------------------
# 分割画面切り替え設定（tmux不使用時のみ）
# ------------------------------------------------------------------------------
# 注意: tmux使用時は上記のFunction Key変換が優先されます
# keybind = cmd+j=goto_split:left
# keybind = cmd+;=goto_split:right
# keybind = cmd+k=goto_split:previous
# keybind = cmd+l=goto_split:next
# keybind = cmd+]=goto_split:next
# keybind = cmd+[=goto_split:previous


# macOS: タイトルバースタイル
macos-titlebar-style = tabs

# グローバルホットキーの設定（例：Option + Space で起動）
# `global:` をつけるのがポイントです
keybind = global:super+9=toggle_quick_terminal

# クイックターミナルのカスタマイズ（お好みで）
quick-terminal-position = bottom
quick-terminal-screen = main
quick-terminal-animation-duration = 0.01
quick-terminal-size = 55%
quick-terminal-autohide = false
quick-terminal-space-behavior = "move"
quick-terminal-screen = mouse


# 背景色を直接指定（テーマより優先されます）
background = #1a1b26

# 背景の透明度（0.0 〜 1.0）
background-opacity = 0.8

# 背景のぼかし具合（透明度を設定している時に有効）
background-blur-radius = 2

# フォント指定（Macにインストールされているもの）
font-family = "JetBrains Mono"
# font-size = 12

# タイトルバーを非表示にする（個人的にイチオシ）
macos-titlebar-style = hidden

# マウススクロール速度調整（デフォルト1.0、小さいほど遅くなる）
mouse-scroll-multiplier = 0.6
