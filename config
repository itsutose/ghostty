# Ghostty Configuration
# https://ghostty.org/docs
# https://qiita.com/genimura/items/7fad3295c4de5538d6fe
# https://zenn.dev/mozumasu/scraps/192ee90fde246f

# ------------------------------------------------------------------------------
# キーバインド設定
# ------------------------------------------------------------------------------
# Cmd+C: マウス選択したテキストのコピー
keybind = super+c=copy_to_clipboard

# Cmd+V: クリップボードからペースト
keybind = super+v=paste_from_clipboard

# Cmd+X が押されたら、F14 キーシーケンス (CSI 26 ~) を送信
# Zsh側でこれを cut-region-to-clipboard にバインドしています
keybind = super+x=text:\x1b[26~

# --- 以下は旧設定（Zsh用キーシーケンス送信）---
# keybind = super+c=text:\x1b[25~
# keybind = super+v=text:\x1b[28~


# 選択したテキストを自動でクリップボードにコピー
copy-on-select = true

# 右クリックでペースト
# right-click-action = paste

# クリップボードの読み書きを許可
clipboard-read = allow
clipboard-write = allow

# タイピング中にマウスカーソルを隠す
mouse-hide-while-typing = true

# GhosttyがCmd+Sを奪わないようにする
keybind = super+s=unbind

# Neovim用カスタムキーバインド（F13-F15）
# Cmd+/ を F13 キーとして送信（コメントトグル）
keybind = super+/=text:\x1b[25~

# Cmd+Z を F14 キーとして送信（Undo）
keybind = super+z=text:\x1b[26~

# Cmd+Shift+Z を F15 キーとして送信（Redo）
keybind = super+shift+z=text:\x1b[28~

# ------------------------------------------------------------------------------
# 分割画面切り替え設定
# ------------------------------------------------------------------------------
# 分割画面の移動設定
keybind = cmd+j=goto_split:left
keybind = cmd+;=goto_split:right
keybind = cmd+k=goto_split:previous
keybind = cmd+l=goto_split:next

# 次の分割画面へ移動（循環）
keybind = cmd+]=goto_split:next

# 前の分割画面へ移動（循環）
keybind = cmd+[=goto_split:previous


# macOS: タイトルバースタイル
macos-titlebar-style = tabs

# グローバルホットキーの設定（例：Option + Space で起動）
# `global:` をつけるのがポイントです
keybind = global:cmd+9=toggle_quick_terminal

# クイックターミナルのカスタマイズ（お好みで）
quick-terminal-position = bottom
quick-terminal-screen = main
quick-terminal-animation-duration = 0.01
quick-terminal-size = 55%
quick-terminal-autohide = false
quick-terminal-space-behavior = "move"
quick-terminal-screen = mouse


# 背景色を直接指定（テーマより優先されます）
background = #1a1b26

# 背景の透明度（0.0 〜 1.0）
background-opacity = 0.8

# 背景のぼかし具合（透明度を設定している時に有効）
background-blur-radius = 2

# フォント指定（Macにインストールされているもの）
font-family = "JetBrains Mono"
# font-size = 12

# タイトルバーを非表示にする（個人的にイチオシ）
# macos-titlebar-style = hidden
